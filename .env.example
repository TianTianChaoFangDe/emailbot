# ---- NoneBot ----
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
ONEBOT_ACCESS_TOKEN=换成随机长字符串        # 必须与 NapCat 端网络配置的 Token 完全一致
LOG_LEVEL=INFO

# ---- 业务配置 ----
MASTER_QQ=主号QQ号                          # 通知推送给这个 QQ, 也只响应这个 QQ 的私聊
QQ_EMAIL=xxx@qq.com
QQ_EMAIL_AUTH_CODE=QQ邮箱IMAP授权码          # 非QQ密码! 网页版QQ邮箱: 设置→账户→开启IMAP/SMTP→生成授权码
IMAP_HOST=imap.qq.com
IMAP_PORT=993
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DATABASE_URL=sqlite+aiosqlite:///data/emailbot.db
MAIL_POLL_MINUTES=30                        # 邮件轮询间隔
ASK_WINDOW_HOURS=6                          # 事件时间窗口超过此时长 -> 发起询问
REMIND_BEFORE_MINUTES=30                    # 日程开始前多久提醒
PENDING_EXPIRE_HOURS=48                     # 询问发出后多久未答视为过期
FIRST_LOOKBACK_DAYS=7                       # 首次运行/UIDVALIDITY 重置时回看几天内的邮件

# ---- apscheduler 插件 ----
APSCHEDULER_AUTOSTART=true
APSCHEDULER_CONFIG={"apscheduler.timezone": "Asia/Shanghai"}
